<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PingWatchdog</AssemblyName>
    <RootNamespace>PingWatchdog.Linux</RootNamespace>
    <Version>1.15.12</Version>
    <Product>Ping Watchdog</Product>
    <Authors>Joseph Luker</Authors>
    <Company>Joseph Luker</Company>
    <Copyright>Copyright © 2026 Joseph Luker. All rights reserved.</Copyright>
    <Description>Multi-site ICMP availability monitoring for Linux.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Assets/WatchdogLogo.png" LogicalName="PingWatchdog.Brand.Logo" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
